+                        || !Objects.equals(previous.getConditionParams(), relation.getConditionParams())) {
+                    log.error("Conflicting DAG relation, workflow={}, edge={}", process.getCode(), edge);
+                    throw new IllegalStateException("Conflicting DolphinScheduler task relation: " + edge);
+                }
+            }
+        }
+        if (uniqueRelations.size() != processTaskRelationList.size()) {
+            log.warn("DAG relation dedup, workflow={}, before={}, after={}",
